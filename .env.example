# Travel Explorer Environment Variables Template

# Database configuration (Defaults to SQLite for local development; supports PostgreSQL)
DATABASE_URL=sqlite:///./travel_explorer.db
# DATABASE_URL=postgresql://user:password@localhost:5432/travel_explorer

# Server Port and Host
HOST=127.0.0.1
PORT=8000

# Optional Google Maps Platform API Key (Leaflet + OpenStreetMap works 100% out-of-the-box without keys)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Credentials (for production OAuth verification)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Weather API (Optional OpenWeatherMap key; default uses live Open-Meteo free API without keys)
OPENWEATHER_API_KEY=your_weather_api_key_here
